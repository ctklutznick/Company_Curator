ANTHROPIC_API_KEY=your-api-key-here

# Global SMTP account — used to SEND all emails (daily reports + welcome emails).
# Friends never configure this; emails are sent from here to each user's address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENT=your-email@gmail.com

# Encryption key for per-user SMTP passwords at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Web — set WEB_BASE_URL to your public https URL in production (e.g. Fly).
# This makes session cookies secure and puts the right link in welcome emails.
WEB_SECRET_KEY=change-me-in-production
WEB_BASE_URL=https://your-app.fly.dev

# In production (Fly) this points at the persistent volume; locally it defaults
# to a file in the project directory.
DATABASE_URL=sqlite:///company_curator.db

# Set to 1 to run the daily 7am pipeline in-process (production only).
RUN_SCHEDULER=0
